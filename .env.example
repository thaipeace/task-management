# Chuỗi kết nối Neon (Dashboard → Connect). Dùng bản pooled (-pooler) cho app.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Mã bí mật để tạo quản trị viên đầu tiên ở /setup (chỉ dùng được khi chưa có người dùng nào).
# Tạo ngẫu nhiên: openssl rand -base64 24
SETUP_SECRET=
